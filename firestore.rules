rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.uid == "nOEaVCR9gGf6uWJ2cwKGZe6gk8J2";
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isSalonStaff(salonId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/salonStaff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/salonStaff/$(request.auth.uid)).data.salonId == salonId;
    }

    function isSalonOwner(salonId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/salons/$(salonId)) &&
        get(/databases/$(database)/documents/salons/$(salonId)).data.ownerId == request.auth.uid;
    }

    // Admin has unrestricted read/write access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Required for collectionGroup("queue") queries (e.g. duplicate-booking check)
    match /{path=**}/queue/{entryId} {
      allow read: if isAuth();
    }

    // Config collection — invite code and other global settings
    match /config/{configId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /salons/{salonId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isSalonStaff(salonId) || isSalonOwner(salonId) || isAdmin() ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["avgRating", "totalRatings", "updatedAt"]));
      allow delete: if isSalonOwner(salonId);

      match /queue/{entryId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.resource.data.status == "waiting" &&
          request.resource.data.customerId == request.auth.uid;
        allow create: if isSalonStaff(salonId) &&
          request.resource.data.type == "walk-in";
        allow update: if isSalonStaff(salonId) ||
          (isAuth() && resource.data.customerId == request.auth.uid &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["status", "position", "stylistId"])) ||
          (isAuth() && resource.data.customerId == request.auth.uid &&
            resource.data.status in ["waiting", "called"] &&
            request.resource.data.status == "no-show");
        allow delete: if isSalonStaff(salonId);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth() &&
          request.resource.data.customerId == request.auth.uid;
        allow update: if
          (isAuth() && resource.data.customerId == request.auth.uid) ||
          (isSalonStaff(salonId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["salonReply", "salonRepliedAt"]));
        allow delete: if isAuth() && resource.data.customerId == request.auth.uid;
      }
    }

    match /salonStaff/{userId} {
      allow read:   if isOwner(userId) || isAdmin() || isSalonStaff(resource.data.salonId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSalonOwner(resource.data.salonId);
      allow delete: if isOwner(userId) || isAdmin() || isSalonOwner(resource.data.salonId) ||
        (isSalonStaff(resource.data.salonId) &&
         get(/databases/$(database)/documents/salonStaff/$(request.auth.uid)).data.role == "owner");
    }

    match /customers/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);

      match /visits/{visitId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId) ||
          (isAuth() && isSalonStaff(request.resource.data.salonId));
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

  }
}
