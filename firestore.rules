rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isSalonStaff(salonId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/salonStaff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/salonStaff/$(request.auth.uid)).data.salonId == salonId;
    }

    function isSalonOwner(salonId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/salons/$(salonId)) &&
        get(/databases/$(database)/documents/salons/$(salonId)).data.ownerId == request.auth.uid;
    }

    match /salons/{salonId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isSalonStaff(salonId) || isSalonOwner(salonId);
      allow delete: if isSalonOwner(salonId);

      match /queue/{entryId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.resource.data.status == "waiting" &&
          request.resource.data.customerId == request.auth.uid;
        allow create: if isSalonStaff(salonId) &&
          request.resource.data.type == "walk-in";
        allow update: if isSalonStaff(salonId) ||
          (isAuth() && resource.data.customerId == request.auth.uid &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["status", "position", "stylistId"]));
        allow delete: if isSalonStaff(salonId);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth() &&
          request.resource.data.customerId == request.auth.uid;
        allow update: if
          (isAuth() && resource.data.customerId == request.auth.uid) ||
          (isSalonStaff(salonId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["salonReply", "salonRepliedAt"]));
        allow delete: if isAuth() && resource.data.customerId == request.auth.uid;
      }
    }

    match /salonStaff/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /customers/{userId} {
      allow read, write: if isOwner(userId);

      match /visits/{visitId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

  }
}
